{
    "player": {
        "name": "vlc-playlist-controller-server",
        "video_directory": "/Users/greg/videos",
        "default_video": "charlie-brown-thanksgiving-portrait-rotated.mp4"
    },
    "vlc": {
        "executable": "cvlc",
        "options": [
            "--vout=drm_vout",
            "--drm-vout-no-modeset",
            "--aout=alsa",
            "--alsa-audio-device=hdmi:CARD=vc4hdmi,DEV=0",
            "--fullscreen",
            "--play-and-exit"
        ]
    },
    "schedule": {
        "videos": [
            "grinch.mp4",
            "charlie-brown-thanksgiving.mp4",
            "charlie-brown-xmas.mp4",
        ],
        "start": "17:00",
        "end": "23:59",
        "sync_secs": 15,
        "sync_delta": 1
    },
    "server": {
        "tcp": {
            "host": "vlc-00",
            "port": 8080,
            "max_clients": 10
        }
    }
}
